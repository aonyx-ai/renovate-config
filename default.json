{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:base"],

  "assignees": ["jdno"],
  "reviewers": ["jdno"],

  "automerge": true,
  "dependencyDashboard": false,
  "semanticCommits": "disabled",
  "pre-commit": {
    "enabled": true
  },

  "packageRules": [
    {
      "description": "Renovate publishes several releases a day, so update its pin once a week.",
      "matchDatasources": ["npm"],
      "matchPackageNames": ["renovate"],
      "extends": ["schedule:weekly"],
      "updateNotScheduled": false
    },
    {
      "description": "A new nightly appears every day, so update its pin once a week.",
      "matchDepNames": ["rust-nightly"],
      "extends": ["schedule:weekly"],
      "updateNotScheduled": false
    },
    {
      "description": "The mise manager reads only the first Rust pin in mise.toml, but the first Rust entry in mise.lock can be a different toolchain. A lockfile update then writes the newest release into that entry, so replace the pin instead.",
      "matchManagers": ["mise"],
      "matchDepNames": ["rust"],
      "rangeStrategy": "replace"
    },
    {
      "description": "The mise manager looks oxlint up as the GitHub repository oxc-project/oxc/oxlint, which does not exist, so it never finds a release. Look its versions up on npm, where oxlint publishes the same releases.",
      "matchManagers": ["mise"],
      "matchDepNames": ["oxlint"],
      "overrideDatasource": "npm",
      "overridePackageName": "oxlint"
    },
    {
      "description": "Rakko publishes no release to crates.io, so a harness depends on each of its crates by Git revision. Advance them in one pull request, because a harness that mixes two revisions does not build.",
      "matchManagers": ["cargo"],
      "matchPackageNames": ["https://github.com/aonyx-ai/rakko"],
      "groupName": "rakko"
    }
  ],

  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": ["^.github/workflows/[\\w]+.yml$"],
      "matchStrings": ["prefix-key: [\\w]+-(?<currentValue>.*?)\\n"],
      "depNameTemplate": "rust",
      "lookupNameTemplate": "rust-lang/rust",
      "datasourceTemplate": "github-tags"
    },
    {
      "customType": "regex",
      "fileMatch": ["(^|/)rust-toolchain\\.toml?$"],
      "matchStrings": [
        "channel\\s*=\\s*\"(?<currentValue>\\d+\\.\\d+(\\.\\d+)?)\""
      ],
      "depNameTemplate": "rust",
      "lookupNameTemplate": "rust-lang/rust",
      "datasourceTemplate": "github-tags"
    },
    {
      "description": "Move a nightly that mise pins by its date to the newest one with rustfmt, in mise.toml and mise.lock together.",
      "customType": "regex",
      "managerFilePatterns": ["mise.toml", "mise.lock"],
      "matchStrings": ["nightly-(?<currentValue>\\d{4}-\\d{2}-\\d{2})"],
      "depNameTemplate": "rust-nightly",
      "datasourceTemplate": "custom.rust-nightly",
      "versioningTemplate": "regex:^(?<major>\\d{4})-(?<minor>\\d{2})-(?<patch>\\d{2})$"
    },
    {
      "description": "Update a version that a comment of the form `# renovate: datasource=... depName=...` annotates in a composite action or a workflow, such as the release of mise that jdx/mise-action installs. No manager reads the input of an action.",
      "customType": "regex",
      "managerFilePatterns": [
        ".github/actions/*/action.yml",
        ".github/workflows/*.yml"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-zA-Z0-9-._]+?) depName=(?<depName>[^\\s]+?)(?: versioning=(?<versioning>[^\\s]+?))?(?: extractVersion=(?<extractVersion>[^\\s]+?))?\\s+version: [\"']?(?<currentValue>.+?)[\"']?\\s"
      ]
    }
  ],

  "customDatasources": {
    "rust-nightly": {
      "defaultRegistryUrlTemplate": "https://rust-lang.github.io/rustup-components-history/x86_64-unknown-linux-gnu/rustfmt.json",
      "format": "json",
      "transformTemplates": [
        "{ \"releases\": [{ \"version\": last_available }] }"
      ]
    }
  }
}
